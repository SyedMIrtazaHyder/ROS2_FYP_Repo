<sdf version='1.9'>
  <world name='car_world'>
    <physics name='1ms' type='ignored'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name='ignition::gazebo::systems::Physics' filename='libignition-gazebo-physics-system.so'/>
    <plugin name='ignition::gazebo::systems::UserCommands' filename='libignition-gazebo-user-commands-system.so'/>
    <plugin name='ignition::gazebo::systems::SceneBroadcaster' filename='libignition-gazebo-scene-broadcaster-system.so'/>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>
    <include>
      <uri>file://<urdf-string></uri>
      <name>vehicle_blue</name>
      <pose>-3.8e-05 0 -0.009387 0 0.011764 0</pose>
    </include>
    <include>
      <uri>file:///root/.ignition/fuel/fuel.gazebosim.org/openrobotics/models/casual female/4</uri>
      <name>casual_female</name>
      <pose>0.584814 -3.58771 0 0 -0 0</pose>
    </include>
    <include>
      <uri>file:///root/.ignition/fuel/fuel.gazebosim.org/openrobotics/models/casual female/4</uri>
      <name>casual_female_0</name>
      <pose>-1.36391 -2.35887 0 0 -0 0</pose>
    </include>
    <include>
      <uri>file:///root/.ignition/fuel/fuel.gazebosim.org/openrobotics/models/casual female/4</uri>
      <name>casual_female_1</name>
      <pose>-3.24455 -3.34843 0 0 -0 0</pose>
    </include>
    <include>
      <uri>file:///root/.ignition/fuel/fuel.gazebosim.org/openrobotics/models/hatchback blue/5</uri>
      <name>hatchback_blue</name>
      <pose>-3.27167 3.96359 0 0 -0 0</pose>
    </include>
    <include>
      <uri>file:///root/.ignition/fuel/fuel.gazebosim.org/openrobotics/models/hatchback blue/5</uri>
      <name>hatchback_blue_0</name>
      <pose>-4.36219 -5.78522 0 0 -0 0</pose>
